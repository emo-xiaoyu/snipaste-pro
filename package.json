{
  "name": "pasty-clipboard",
  "version": "0.1.0",
  "description": "A small, keyboard-first local clipboard manager for Windows.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:desktop": "npm run icons:build && vite build && electron-builder --win nsis",
    "preview": "vite preview",
    "icons:build": "node scripts/generate-app-icons.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.316",
    "@gutenye/ocr-node": "^1.4.8",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "^7.0.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.pasty",
    "productName": "Pasty",
    "artifactName": "Pasty-Setup-${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@gutenye/**/*",
      "node_modules/@img/**/*",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*",
      "node_modules/sharp/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pasty",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
