{
  "name": "pasty-clipboard",
  "version": "0.1.0",
  "description": "A small, keyboard-first local clipboard manager for Windows.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:tauri && src-tauri/target/release/pasty.exe",
    "start:debug": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml && src-tauri/target/debug/pasty.exe",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:tauri": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "icons:build": "node scripts/generate-app-icons.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-pin-check.ps1",
    "check:deps": "node scripts/check-deps.mjs",
    "build:portable": "npm run build:tauri && node scripts/build-portable-tauri.mjs"
  },
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.316",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.5",
    "vite": "6.4.2"
  }
}
